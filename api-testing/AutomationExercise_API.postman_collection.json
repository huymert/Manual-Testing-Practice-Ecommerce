    {
      "name": "API 14: GET user account detail by email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Application responseCode is 200\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.responseCode).to.eql(200);",
              "});",
              "pm.test(\"User detail schema verification\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('user');",
              "    // Changed to .include.all.keys to allow extra/optional keys returned from the database",
              "    pm.expect(jsonData.user).to.include.all.keys('id', 'name', 'email', 'first_name', 'last_name', 'address1', 'city', 'state', 'zipcode', 'country');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
