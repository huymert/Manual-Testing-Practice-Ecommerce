    {
      "name": "API 1: Get All Products List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Application responseCode is 200\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.responseCode).to.eql(200);",
              "});",
              "pm.test(\"Response body contains products array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('products');",
              "    pm.expect(jsonData.products).to.be.an('array');",
              "    pm.expect(jsonData.products.length).to.be.above(0);",
              "});",
              "pm.test(\"Product schema validation\", function () {",
              "    var jsonData = pm.response.json();",
              "    var product = jsonData.products[0];",
              "    pm.expect(product).to.include.all.keys('id', 'name', 'price', 'brand', 'category');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/productsList",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productsList"
          ]
        }
      },
      "response": []
    },
